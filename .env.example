# DrivePost settings. Copy to .env and fill in (see the setup guide).
# One setting per line, no spaces around =, no quotes.

# The server's own passcode. It opens the Admin page (your address + /admin),
# where you allow a profile for each person or car, and nothing else: it is
# not a profile's passcode. Each profile has a passcode of its own, chosen by
# the person who asks for it on the sign-in page.
DRIVE_PASSCODE=change-me

# Your public address, once the Cloudflare Tunnel is set up. Leave blank while
# testing on your home network.
PUBLIC_URL=

# No longer needed. Every profile gets an iPhone Shortcut link of its own,
# kept with the profile, and Setup & sharing can replace it. This line is only
# read once, when a server from before profiles existed is first updated, to
# carry its Shortcut over. You can leave it blank or delete it.
SHARE_TOKEN=

# Default quality: 360, 480, 720 or 1080. A Raspberry Pi 4 should stay at 480.
# 1080 needs a fast server, about 5.5 Mbps of upload, and a fast screen.
DEFAULT_QUALITY=480

# Max videos converting at once, per profile (older ones are stopped first).
MAX_STREAMS=3

# Cloudflare Tunnel token (only needed with: docker compose --profile tunnel up -d)
TUNNEL_TOKEN=

# Where the car's Feedback button sends people (a QR code to a pre-filled
# GitHub issue). Point it at your own fork, or leave it empty to hide the button.
# FEEDBACK_URL=https://github.com/5w311/DrivePost/issues/new

# Optional extras passed to yt-dlp, e.g. a cookies file for age-restricted videos:
# YTDLP_ARGS=--cookies /data/cookies.txt
