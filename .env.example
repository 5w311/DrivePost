# DriveTest settings. Copy to .env and fill in (see the setup guide).
# One setting per line, no spaces around =, no quotes.

# Passcode you type once in the car (and on any phone that doesn't pair by QR).
DRIVE_PASSCODE=change-me

# Your public address, once the Cloudflare Tunnel is set up. Leave blank while
# testing on your home network.
PUBLIC_URL=

# Fixed token for the iPhone Shortcut, so it keeps working if you move the
# app to another machine. Make one with: openssl rand -hex 24
SHARE_TOKEN=

# Default quality: 360, 480 or 720. A Raspberry Pi 4 should stay at 480.
DEFAULT_QUALITY=480

# Max videos converting at once (older ones are stopped first).
MAX_STREAMS=3

# Cloudflare Tunnel token (only needed with: docker compose --profile tunnel up -d)
TUNNEL_TOKEN=

# Optional extras passed to yt-dlp, e.g. a cookies file for age-restricted videos:
# YTDLP_ARGS=--cookies /data/cookies.txt
